# Local development uses SQLite. On Vercel replace DATABASE_URL with the
# Supabase transaction-pooler PostgreSQL URI and set DIRECT_URL for migrations.
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# Leave Supabase values empty to use the private single-user SQLite workspace.
# Cloud mode requires all Supabase values plus a PostgreSQL DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
